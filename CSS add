/* ===================================================================== */
/*  v26 — PAGE PANIER : MISE EN PAGE DU SIMULATEUR ET DE LA BULLE TOTAL  */
/* ===================================================================== */

/* --- 1) Le simulateur occupe sa propre ligne, pleine largeur ---------- */
/*     Sans cela il devient un element flex de la grille 2 colonnes de la */
/*     v20 et vient se glisser a cote du recapitulatif.                   */
body.woocommerce-cart .woocommerce .es-simul,
body.woocommerce-cart .es-simul{
  flex:0 0 100% !important; max-width:100% !important; width:100% !important;
  order:99 !important;          /* toujours en dernier, tout en bas */
  align-self:stretch !important;
  position:relative !important; z-index:1 !important;
}

/* --- 2) La bulle "Total panier" ne suit plus le defilement ------------ */
/*     La v21 la rendait sticky. Comme le simulateur se trouve SOUS les   */
/*     deux colonnes et que le sticky se deplace dans tout le conteneur   */
/*     flex, la bulle descendait par-dessus le simulateur et masquait ses */
/*     informations. On la remet dans le flux : elle reste en haut a       */
/*     droite, bien visible, et ne recouvre plus rien.                    */
@media(min-width:993px){
  body.woocommerce-cart .woocommerce .cart-collaterals{
    position:static !important;
    top:auto !important;
    align-self:flex-start !important;
  }
  body.woocommerce-cart .woocommerce .cart-collaterals .cart_totals{
    position:static !important;
  }
}



