/*  Les pages Panier/Commande modernes utilisent des classes .wc-block-* */
/*  qui n'avaient AUCUN fond -> elles restaient transparentes (couleur    */
/*  de l'arrière-plan). On leur donne ici de vrais cadres professionnels. */
/* ===================================================================== */

/* --- Colonne principale (liste produits panier / formulaire commande) - */
.wp-block-woocommerce-cart .wc-block-cart__main,
.wp-block-woocommerce-checkout .wc-block-checkout__main,
.wc-block-checkout__main,
.wc-block-cart__main{
  background:linear-gradient(180deg,#FFFFFF 0%,#F5FAFF 100%) !important;
  border:1.5px solid #D0E1F9 !important; border-radius:24px !important;
  box-shadow:0 24px 54px rgba(10,41,66,.15) !important;
  padding:30px 32px !important; position:relative; z-index:1;
}

/* --- Colonne latérale : RÉSUMÉ / TOTAL (le bloc qui restait vide) ----- */
.wc-block-checkout__sidebar,
.wc-block-cart__sidebar,
.wc-block-components-sidebar,
.wp-block-woocommerce-checkout-order-summary-block,
.wp-block-woocommerce-cart-order-summary-block{
  background:linear-gradient(180deg,#FFFFFF 0%,#F1F7FF 100%) !important;
  border:1.5px solid #CFE0F8 !important; border-radius:24px !important;
  box-shadow:0 26px 58px rgba(10,41,66,.18), inset 0 5px 0 #1b9fd1 !important;
  padding:26px 26px 28px !important; overflow:hidden !important; position:relative; z-index:1;
}

/* Titre du récap commande (blocs) -> pastille dégradée bien visible */
.wc-block-components-checkout-order-summary__title,
.wc-block-checkout__sidebar .wc-block-components-title,
.wc-block-cart__sidebar .wc-block-components-title{
  display:inline-block; background:linear-gradient(135deg,#0a2942,#1b9fd1) !important; color:#fff !important;
  padding:10px 22px !important; border-radius:30px !important; font-size:16px !important; font-weight:900 !important;
  margin:0 0 18px !important; box-shadow:0 10px 24px rgba(46,182,230,.28); text-transform:uppercase; letter-spacing:.4px;
}

/* Totaux : valeur du total bien mise en valeur */
.wc-block-components-totals-footer-item .wc-block-components-totals-item__value,
.wc-block-components-totals-item.wc-block-components-totals-footer-item .wc-block-components-totals-item__value{
  color:#1558B0 !important; font-weight:900 !important; font-size:25px !important;
}
.wc-block-components-totals-item__label{ color:#5b6b7d !important; }
.wc-block-components-totals-wrapper{ border-top-color:#E1EBFA !important; }

/* Vignettes produit dans le récap (blocs) */
.wc-block-components-order-summary-item__image img,
.wc-block-cart-item__image img{
  border-radius:12px !important; border:1px solid #E1EBFA !important; background:linear-gradient(160deg,#EEF5FF,#fff) !important; padding:6px !important;
}

/* Bloc PAIEMENT (blocs) */
.wp-block-woocommerce-checkout-payment-block,
.wc-block-checkout__payment-method{
  background:linear-gradient(180deg,#F4F9FF,#FFFFFF) !important; border:1px solid #E1EBFA !important; border-radius:16px !important; padding:18px 18px !important; margin-top:8px;
}

/* Champs de saisie (blocs) cohérents avec le reste */
.wc-block-components-text-input input,
.wc-block-components-text-input input.is-active,
.wc-block-checkout .wc-block-components-text-input input{
  background:#fff !important; border:1.5px solid #dde5ec !important; border-radius:11px !important; color:#0a2942 !important;
}

/* Étapes du checkout en blocs : petit cadre interne propre */
.wc-block-components-checkout-step{ border-bottom:1px solid #f4f7fb !important; }
.wc-block-components-checkout-step__title{ color:#0a2942 !important; font-weight:800 !important; }

/* Bouton "Passer la commande" (blocs) */
.wc-block-components-checkout-place-order-button,
.wp-block-woocommerce-checkout-actions-block button{
  background:linear-gradient(135deg,#1b9fd1,#2eb6e6) !important; color:#fff !important; border:none !important; border-radius:12px !important;
  font-weight:800 !important; box-shadow:0 14px 32px rgba(46,182,230,.30) !important;
}

/* Sécurité : si un wrapper de bloc reste transparent, on garde le contenu
   lisible au-dessus du fond dégradé de la page. */
.wp-block-woocommerce-cart,.wp-block-woocommerce-checkout{ position:relative; z-index:1; }


/* ===================================================================== */
/*  v18 — RENFORCEMENT PANIER & COMMANDE "CLASSIQUES"                    */
/*  Sélecteurs très spécifiques (body.classe + .woocommerce + ...) pour  */
/*  passer DEVANT tout style du thème. Teinte nettement distincte du fond */
/*  pour que les encadrés ressortent vraiment.                           */
/* ===================================================================== */

/* --- Total du panier (page Panier classique) ------------------------- */
body.woocommerce-cart .woocommerce .cart-collaterals .cart_totals,
body.woocommerce-cart .cart-collaterals .cart_totals{
  background:linear-gradient(180deg,#FFFFFF 0%,#E9F2FF 100%) !important;
  border:1.5px solid #C5D9F6 !important; border-radius:24px !important;
  box-shadow:0 26px 58px rgba(10,41,66,.20) !important; overflow:hidden !important;
}

/* --- Tableau du panier ---------------------------------------------- */
body.woocommerce-cart .woocommerce table.shop_table.cart,
body.woocommerce-cart table.shop_table.cart{
  background:linear-gradient(180deg,#FFFFFF 0%,#F4F9FF 100%) !important;
  border:1.5px solid #C5D9F6 !important; border-radius:22px !important;
  box-shadow:0 24px 54px rgba(10,41,66,.16) !important;
}

/* --- Sections de la page Commande (classique) ----------------------- */
body.woocommerce-checkout .woocommerce .woocommerce-billing-fields,
body.woocommerce-checkout .woocommerce .woocommerce-shipping-fields,
body.woocommerce-checkout .woocommerce .woocommerce-additional-fields,
body.woocommerce-checkout .woocommerce #order_review,
body.woocommerce-checkout #order_review,
body.woocommerce-checkout .woocommerce form.checkout_coupon{
  background:linear-gradient(180deg,#FFFFFF 0%,#E9F2FF 100%) !important;
  border:1.5px solid #C5D9F6 !important; border-radius:24px !important;
  box-shadow:0 24px 54px rgba(10,41,66,.18) !important;
  padding:30px 30px 28px !important; position:relative; z-index:1;
}
/* liseré coloré en haut de chaque section (vrai cadre, pas un bloc plat) */
body.woocommerce-checkout .woocommerce .woocommerce-billing-fields{ box-shadow:0 24px 54px rgba(10,41,66,.18), inset 0 5px 0 #1b9fd1 !important; }
body.woocommerce-checkout .woocommerce .woocommerce-shipping-fields{ box-shadow:0 24px 54px rgba(10,41,66,.18), inset 0 5px 0 #35c6f0 !important; }
body.woocommerce-checkout .woocommerce #order_review,
body.woocommerce-checkout #order_review{ box-shadow:0 24px 54px rgba(10,41,66,.18), inset 0 5px 0 #22C55E !important; }

/* --- Zone de paiement (classique) ----------------------------------- */
body.woocommerce-checkout #payment,
body.woocommerce-checkout .woocommerce #payment{
  background:linear-gradient(180deg,#F2F8FF 0%,#FFFFFF 100%) !important;
  border:1px solid #dde5ec !important; border-radius:16px !important;
}

/* --- Titre "Votre commande" en pastille bien visible ---------------- */
body.woocommerce-checkout #order_review_heading{
  display:inline-block !important; background:linear-gradient(135deg,#0a2942,#1b9fd1) !important; color:#fff !important;
  padding:12px 24px !important; border-radius:30px !important; font-weight:900 !important;
  box-shadow:0 10px 24px rgba(46,182,230,.28) !important; margin:6px 0 16px !important;
}


/* ===================================================================== */
/*  v19 — SECTION "LIVRAISON ÉVÉNEMENTIELLE" (checkout) — v2 flexbox      */
/* ===================================================================== */
body.woocommerce-checkout #eauservice_event_delivery.es-event-section{
  display:flex !important; flex-wrap:wrap !important; gap:0 3% !important;
  background:linear-gradient(180deg,#FFFFFF 0%,#eaf3fb 100%) !important;
  border:1.5px solid #C5D9F6 !important; border-radius:24px !important;
  box-shadow:0 24px 54px rgba(10,41,66,.16), inset 0 5px 0 #1b9fd1 !important;
  padding:28px 30px 24px !important; margin:22px 0 26px !important; position:relative; z-index:1;
}
body.woocommerce-checkout .es-event-section > *{
  flex:0 0 100% !important; max-width:100% !important;
}
body.woocommerce-checkout .es-event-section h3{
  display:inline-block; background:linear-gradient(135deg,#0a2942,#1b9fd1) !important; color:#fff !important;
  padding:11px 22px !important; border-radius:30px !important; font-size:16px !important; font-weight:900 !important;
  margin:0 0 6px !important; box-shadow:0 10px 24px rgba(46,182,230,.28); letter-spacing:.3px;
}
body.woocommerce-checkout .es-event-section .es-event-intro{
  color:#5b6b7d !important; font-size:13.5px; margin:8px 0 18px !important; line-height:1.6;
}
body.woocommerce-checkout .es-event-section .form-row{
  margin-bottom:14px !important; padding:0 !important;
}
body.woocommerce-checkout .es-event-section .form-row-first,
body.woocommerce-checkout .es-event-section .form-row-last{
  flex:0 0 48.5% !important; max-width:48.5% !important;
}
body.woocommerce-checkout .es-event-section .form-row-wide{
  flex:0 0 100% !important; max-width:100% !important;
}
body.woocommerce-checkout .es-event-section label{ color:#0a2942 !important; font-weight:700 !important; font-size:13.5px; margin-bottom:6px; display:block; }
body.woocommerce-checkout .es-event-section .required{ color:#1b9fd1; }
body.woocommerce-checkout .es-event-section input,
body.woocommerce-checkout .es-event-section textarea{
  background:#fff !important; border:1.5px solid #dde5ec !important; border-radius:11px !important; color:#0a2942 !important;
  padding:13px 14px !important; width:100% !important; box-sizing:border-box; transition:border-color .2s, box-shadow .2s;
}
body.woocommerce-checkout .es-event-section input:focus,
body.woocommerce-checkout .es-event-section textarea:focus{ outline:none; border-color:#1b9fd1 !important; box-shadow:0 0 0 4px rgba(46,182,230,.12) !important; }
body.woocommerce-checkout .es-event-section textarea{ min-height:90px; resize:vertical; }

/* Séparateur "Informations complémentaires" */
body.woocommerce-checkout .es-event-section .es-event-optional-head{
  flex:0 0 100% !important; max-width:100% !important;
  margin:8px 0 14px !important; padding-top:16px !important;
  border-top:1px dashed #C5D9F6;
  font-size:12px; font-weight:800; letter-spacing:1.5px; text-transform:uppercase;
  color:#8ba6c2;
}

/* Sur mobile : toujours 1 colonne */
@media(max-width:600px){
  body.woocommerce-checkout .es-event-section .form-row-first,
  body.woocommerce-checkout .es-event-section .form-row-last{
    flex:0 0 100% !important; max-width:100% !important;
  }
}

/* Masque le bloc natif "adresse différente" par sécurité, même si le
   filtre PHP échouait pour une raison quelconque (cache, plugin...) */
body.woocommerce-checkout .woocommerce-shipping-fields{ display:none !important; }

/* "Notes de commande" et "Identification du client", une fois déplacés
   en bas par le script JS : un peu d'espace au-dessus pour bien les séparer */
body.woocommerce-checkout #order_comments_field,
body.woocommerce-checkout .woocommerce-account-fields{
  margin-top:24px !important;
}


/* ===================================================================== */
/*  v20 — CORRECTIONS BULLES + PANIER 2 COLONNES                        */
/* ===================================================================== */

/* --- 1) TEXTE BLANC dans toutes les "bulles" bleu foncé -------------- */
/*    (titres en pastille : Total panier, Votre commande, Livraison       */
/*    événementielle). On force le blanc avec un sélecteur fort + on      */
/*    supprime la barre ::before parasite qui "buggait" la bulle.         */
body.woocommerce-cart .cart_totals h2,
body.woocommerce-cart .cart_totals h2 *,
body.woocommerce-checkout #order_review_heading,
body.woocommerce-checkout .es-event-section h3,
body.woocommerce-checkout .es-event-section h3 *{
  color:#FFFFFF !important; -webkit-text-fill-color:#FFFFFF !important;
}
/* on enlève la barre verticale ::before sur les titres devenus pastilles */
body.woocommerce-cart .cart_totals h2::before,
body.woocommerce-checkout #order_review_heading::before,
body.woocommerce-checkout .es-event-section h3::before{
  display:none !important; content:none !important;
}
/* le titre "Total panier" : on lui enlève le padding-left hérité et on    */
/* le présente comme un beau bandeau plein en haut de la carte.            */
body.woocommerce-cart .cart_totals h2{
  padding:18px 26px !important; margin:0 0 16px !important; border-radius:0 !important;
  background:linear-gradient(135deg,#0a2942 0%,#1b9fd1 130%) !important;
  text-transform:uppercase; letter-spacing:.4px; font-size:17px !important;
}

/* --- 2) PANIER : liste à GAUCHE, total à DROITE (2 colonnes) --------- */
@media(min-width:993px){
  body.woocommerce-cart .woocommerce{
    display:flex !important; flex-wrap:wrap; align-items:flex-start; gap:30px;
  }
  /* les messages restent pleine largeur en haut */
  body.woocommerce-cart .woocommerce > .woocommerce-notices-wrapper{
    flex:0 0 100% !important; width:100% !important;
  }
  /* colonne gauche : le tableau des produits */
  body.woocommerce-cart .woocommerce .woocommerce-cart-form{
    flex:1 1 60% !important; min-width:0 !important; margin:0 !important;
  }
  /* colonne droite : le récap / total */
  body.woocommerce-cart .woocommerce .cart-collaterals{
    flex:1 1 33% !important; width:auto !important; float:none !important; margin:0 !important;
  }
  body.woocommerce-cart .woocommerce .cart-collaterals .cart_totals{
    width:100% !important; float:none !important; margin:0 !important;
  }
}

/* --- 3) Petites finitions des bulles checkout ----------------------- */
/*    on s'assure que les pastilles ne se coupent pas / ne débordent pas. */
body.woocommerce-checkout #order_review_heading,
body.woocommerce-checkout .es-event-section h3{
  max-width:100%; line-height:1.25 !important; white-space:normal !important;
}


/* ===================================================================== */
/*  v21 — TOTAL PANIER TOUJOURS VISIBLE (haut + sticky)                 */
/* ===================================================================== */
@media(min-width:993px){
  /* la colonne de droite se cale EN HAUT (pas en bas) et suit le scroll */
  body.woocommerce-cart .woocommerce .cart-collaterals{
    align-self:flex-start !important;
    position:sticky !important; top:24px !important;
  }
  body.woocommerce-cart .woocommerce .cart-collaterals .cart_totals{
    position:static !important; /* le sticky est porté par la colonne */
  }
  /* le tableau produits commence bien en haut lui aussi */
  body.woocommerce-cart .woocommerce .woocommerce-cart-form{
    align-self:flex-start !important;
  }
}


/* ===================================================================== */
/*  v22 — VITRINE BOUTIQUE : contenus enrichis (hero, réassurance, FAQ)  */
/*  Ces styles habillent les blocs HTML que vous collez sur la page      */
/*  Boutique (voir le fichier "boutique-contenu-seo.html").              */
/* ===================================================================== */

/* --- HERO / intro SEO en haut de la boutique ------------------------ */
.es-hero{
  position:relative; z-index:1; overflow:hidden;
  background:linear-gradient(135deg,#061726 0%,#0a2942 60%,#1b9fd1 135%);
  border-radius:24px; padding:46px 46px; margin:0 0 30px;
  box-shadow:0 26px 60px rgba(10,22,40,.28); border:1px solid rgba(255,255,255,.06);
}
.es-hero::before{
  content:''; position:absolute; inset:0; pointer-events:none;
  background:
    radial-gradient(560px 380px at 92% -20%, rgba(53,198,240,.4), transparent 60%),
    radial-gradient(460px 360px at -6% 130%, rgba(46,182,230,.32), transparent 60%);
}
.es-hero > *{ position:relative; z-index:1; }
.es-hero .es-eyebrow{ display:inline-block; font-size:12px; font-weight:800; letter-spacing:3px; color:#35c6f0; text-transform:uppercase; margin-bottom:14px; }
.es-hero h1,.es-hero h2{
  color:#fff !important; font-size:clamp(26px,3.4vw,40px) !important; font-weight:900 !important;
  letter-spacing:-1px; line-height:1.15; margin:0 0 14px !important;
}
.es-hero p{ color:#c3d4e6 !important; font-size:16px; line-height:1.75; max-width:760px; margin:0 0 10px !important; }
.es-hero .es-hero-tags{ margin-top:18px; display:flex; flex-wrap:wrap; gap:10px; }
.es-hero .es-hero-tags span{
  background:rgba(255,255,255,.10); border:1px solid rgba(255,255,255,.18); color:#eaf3fb;
  font-size:13px; font-weight:600; padding:7px 14px; border-radius:30px; backdrop-filter:blur(4px);
}

/* --- BANDE DE RÉASSURANCE (4 atouts) -------------------------------- */
.es-assur{
  position:relative; z-index:1; display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin:0 0 32px;
}
.es-assur .es-assur-item{
  background:linear-gradient(180deg,#FFFFFF,#F4F9FF); border:1.5px solid #dde5ec; border-radius:18px;
  padding:22px 20px; text-align:center; box-shadow:0 12px 30px rgba(10,41,66,.10); transition:transform .25s, box-shadow .25s;
}
.es-assur .es-assur-item:hover{ transform:translateY(-5px); box-shadow:0 22px 44px rgba(46,182,230,.18); }
.es-assur .es-assur-ico{
  width:52px; height:52px; margin:0 auto 12px; border-radius:14px; display:flex; align-items:center; justify-content:center;
  background:linear-gradient(135deg,#1b9fd1,#2eb6e6); color:#fff; font-size:24px; box-shadow:0 10px 22px rgba(46,182,230,.32);
}
.es-assur .es-assur-t{ font-weight:800; color:#0a2942; font-size:15px; margin-bottom:4px; }
.es-assur .es-assur-d{ font-size:13px; color:#5b6b7d; line-height:1.5; }

/* --- TITRE DE SECTION (avant la grille produits / la FAQ) ----------- */
.es-section-head{ position:relative; z-index:1; text-align:center; margin:6px 0 26px; }
.es-section-head .es-eyebrow{ display:inline-block; font-size:12px; font-weight:800; letter-spacing:3px; color:#1b9fd1; text-transform:uppercase; margin-bottom:8px; }
.es-section-head h2{ color:#0a2942 !important; font-size:clamp(22px,2.6vw,32px) !important; font-weight:900 !important; letter-spacing:-.6px; margin:0 auto !important; }
.es-section-head p{ color:#5b6b7d !important; max-width:620px; margin:10px auto 0 !important; line-height:1.7; }
.es-section-head h2::after{ content:''; display:block; width:64px; height:4px; margin:14px auto 0; border-radius:3px; background:linear-gradient(90deg,#1b9fd1,#35c6f0); }

/* --- FAQ ------------------------------------------------------------ */
.es-faq{ position:relative; z-index:1; max-width:840px; margin:8px auto 36px; }
.es-faq details{
  background:linear-gradient(180deg,#FFFFFF,#F6FAFF); border:1.5px solid #dde5ec; border-radius:16px;
  padding:0 22px; margin-bottom:14px; box-shadow:0 10px 26px rgba(10,41,66,.08); overflow:hidden; transition:border-color .2s, box-shadow .2s;
}
.es-faq details[open]{ border-color:#9FC2F0; box-shadow:0 18px 40px rgba(46,182,230,.16); }
.es-faq summary{
  list-style:none; cursor:pointer; padding:18px 36px 18px 0; position:relative;
  font-weight:800; color:#0a2942; font-size:16px; line-height:1.4;
}
.es-faq summary::-webkit-details-marker{ display:none; }
.es-faq summary::after{
  content:'+'; position:absolute; right:0; top:50%; transform:translateY(-50%);
  width:28px; height:28px; border-radius:50%; background:#e7f7fe; color:#1b9fd1; font-weight:900; font-size:18px;
  display:flex; align-items:center; justify-content:center; transition:transform .25s, background .2s;
}
.es-faq details[open] summary::after{ content:'\2212'; background:#1b9fd1; color:#fff; }
.es-faq .es-faq-a{ color:#5b6b7d; line-height:1.75; font-size:14.5px; padding:0 0 20px; }

/* --- BLOC CTA bas de page (devis) ----------------------------------- */
.es-cta-band{
  position:relative; z-index:1; overflow:hidden; text-align:center;
  background:linear-gradient(135deg,#061726,#0a2942 70%,#1b9fd1 140%);
  border-radius:24px; padding:42px 30px; margin:6px 0 30px; box-shadow:0 26px 60px rgba(10,22,40,.26);
}
.es-cta-band h2{ color:#fff !important; font-size:clamp(22px,2.6vw,30px) !important; font-weight:900 !important; margin:0 0 10px !important; letter-spacing:-.5px; }
.es-cta-band p{ color:#c3d4e6 !important; margin:0 0 22px !important; }
.es-cta-band a.es-cta-btn{
  display:inline-block; background:#fff; color:#0a2942 !important; font-weight:800; font-size:15px;
  padding:15px 34px; border-radius:12px; text-decoration:none !important; box-shadow:0 14px 30px rgba(0,0,0,.22); transition:transform .2s, box-shadow .2s;
}
.es-cta-band a.es-cta-btn:hover{ transform:translateY(-3px); box-shadow:0 20px 40px rgba(0,0,0,.3); }

/* --- Responsive ----------------------------------------------------- */
@media(max-width:900px){ .es-assur{ grid-template-columns:1fr 1fr; } }
@media(max-width:560px){
  .es-assur{ grid-template-columns:1fr; }
  .es-hero{ padding:32px 24px; }
}


/* ===================================================================== */
/*  v23 — PAGE DE CONFIRMATION DE COMMANDE (merci / order-received)      */
/*  Récap propre + bannière de remerciement + encart contact.            */
/* ===================================================================== */

/* Message PAR DÉFAUT de WooCommerce ("Merci. Votre commande a été reçue.") */
/* -> agrandi, centré, bien visible (avant : petit, gris, à gauche).        */
.woocommerce-order > p.woocommerce-notice--success,
.woocommerce-order p.woocommerce-thankyou-order-received,
p.woocommerce-thankyou-order-received{
  text-align:center !important; font-size:20px !important; font-weight:800 !important;
  color:#0a2942 !important; background:#EAF7EE !important; border:1.5px solid #B6E6C8 !important;
  border-radius:14px !important; padding:18px 22px !important; margin:0 0 22px !important;
  box-shadow:0 10px 26px rgba(10,41,66,.08) !important;
}

/* Bandeau "Merci pour votre commande" (sélecteur direct = toujours appliqué) */
.es-thankyou-banner{
  position:relative; z-index:1; text-align:center; color:#fff;
  background:linear-gradient(135deg,#061726 0%,#0a2942 65%,#1b9fd1 140%);
  border-radius:24px; padding:44px 30px 38px; margin:0 0 26px;
  box-shadow:0 26px 60px rgba(10,22,40,.26); overflow:hidden;
}
.es-thankyou-banner::before{
  content:''; position:absolute; inset:0; pointer-events:none;
  background:radial-gradient(520px 360px at 90% -20%, rgba(53,198,240,.4), transparent 60%);
}
.es-thankyou-banner > *{ position:relative; z-index:1; }
.es-thankyou-banner .es-ty-check{
  width:70px; height:70px; margin:0 auto 18px; border-radius:50%;
