/* ===================================================================== */
/*  EAUSERVICE — FEUILLE DE STYLE BOUTIQUE  v2 (theme clair + aqua)     */
/*  >>> REMPLACE TOUT le contenu de "CSS additionnel" par ce fichier <<< */
/*  --------------------------------------------------------------------  */
/*  Nouveautés v15 :                                                      */
/*   • Images fondues dans les cartes (fond blanc pur, plus de "cadre")   */
/*   • Cartes plus compactes, boutons toujours alignés en bas             */
/*   • Select "Tri par défaut" plus visible                               */
/*   • Badge "EN RUPTURE DE STOCK" stylé                                  */
/*   • Fiche produit (clic "Lire la suite") améliorée                     */
/*   • Panier : images alignées                                           */
/* ===================================================================== */

@import url("https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap");

:root{
  --es-blue:#1b9fd1; --es-blue2:#2eb6e6; --es-azure:#35c6f0;
  --es-ink:#0a2942; --es-slate:#5b6b7d; --es-mist:#8ba6c2;
  --es-line:#e7edf3; --es-line2:#dde5ec; --es-soft:#f4f7fb;
  --es-ease:cubic-bezier(.4,0,.2,1);
}

/* =========================  EN-TÊTE & PIED (navy)  =================== */
.site-header,#masthead,.ast-primary-header-bar,.main-header-bar,
.ast-main-header-wrap .main-header-bar,.ast-above-header,.ast-below-header{
  background:#061726 !important; border:none !important; box-shadow:0 1px 0 rgba(255,255,255,.06) !important;
}
.site-title,.ast-site-title-wrap .site-title,.ast-site-identity .site-title,
.site-header .site-title,.ast-logo-title-inline .site-title{ display:none !important; }
.site-description,.ast-site-identity .site-description{ color:#8ba6c2 !important; }
.main-header-menu .menu-link,.ast-builder-menu .menu-link,.main-header-menu a,
#ast-hf-menu-1 .menu-link,.ast-masthead-custom-menu-items a{
  color:#c3d4e6 !important; font-weight:600 !important; font-family:'Manrope',system-ui,sans-serif !important;
}
.main-header-menu .menu-link:hover,.ast-builder-menu .menu-link:hover,
.main-header-menu .current-menu-item>.menu-link{ color:#35c6f0 !important; }
.main-header-menu .sub-menu,.ast-builder-menu .sub-menu{ background:#0a2942 !important; border:1px solid rgba(255,255,255,.08) !important; }
.ast-header-woo-cart .ast-cart-menu-wrap,.ast-site-header-cart a,.ast-header-account-wrap a{ color:#c3d4e6 !important; }
.ast-mobile-menu-buttons-minimal,.main-header-menu-toggle{ color:#fff !important; }
.site-footer,#colophon,.ast-small-footer,.footer-sml-layout,.ast-footer-overlay,footer.site-footer{
  background:#061726 !important; color:#8ba6c2 !important; border:none !important;
}
.site-footer a,#colophon a,.ast-small-footer a{ color:#c3d4e6 !important; }
.site-footer a:hover,#colophon a:hover{ color:#35c6f0 !important; }

/* ============  FOND DE PAGE BOUTIQUE (plus profond + texturé)  ====== */
/* Condition "page boutique/panier/commande" — JAMAIS l'accueil/le blog. */
body:is(
  :has(#content .woocommerce), :has(#primary .woocommerce),
  :has(.site-content .woocommerce), :has(.entry-content .woocommerce),
  .woocommerce-cart, .woocommerce-checkout, .woocommerce-account,
  .post-type-archive-product, .single-product, .tax-product_cat
){
  background:
    radial-gradient(900px 620px at 10% -8%, rgba(46,182,230,.30), transparent 46%),
    radial-gradient(820px 660px at 102% 0%, rgba(53,198,240,.32), transparent 50%),
    radial-gradient(1100px 900px at 50% 122%, rgba(10,41,66,.26), transparent 62%),
    linear-gradient(180deg,#eef3f8 0%, #f1f5fa 380px, #f4f7fb 100%) !important;
  background-attachment:fixed !important;
  color:#0a2942 !important;
  font-family:'Manrope',system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif !important;
}
/* trame de points discrète, fondue en haut */
body:is(
  :has(#content .woocommerce), :has(#primary .woocommerce),
  :has(.site-content .woocommerce), :has(.entry-content .woocommerce),
  .woocommerce-cart, .woocommerce-checkout, .woocommerce-account,
  .post-type-archive-product, .single-product, .tax-product_cat
)::before{
  content:''; position:fixed; inset:0; z-index:0; pointer-events:none;
  background-image:radial-gradient(rgba(10,41,66,.10) 1px, transparent 1.6px);
  background-size:26px 26px;
  -webkit-mask-image:radial-gradient(150% 120% at 50% -12%, #000 42%, transparent 100%);
  mask-image:radial-gradient(150% 120% at 50% -12%, #000 42%, transparent 100%);
}
/* léger vignettage en bas pour la profondeur */
body:is(
  :has(#content .woocommerce), :has(#primary .woocommerce),
  :has(.site-content .woocommerce), :has(.entry-content .woocommerce),
  .woocommerce-cart, .woocommerce-checkout, .woocommerce-account,
  .post-type-archive-product, .single-product, .tax-product_cat
)::after{
  content:''; position:fixed; inset:0; z-index:0; pointer-events:none;
  background:radial-gradient(120% 80% at 50% 122%, rgba(10,22,40,.12), transparent 60%);
}

/* On rend transparente la boîte blanche d'Astra, ET on remet le contenu */
/* au-dessus de la texture (z-index:1).                                  */
body:is(
  :has(#content .woocommerce), :has(.site-content .woocommerce),
  .woocommerce-cart, .woocommerce-checkout, .woocommerce-account,
  .post-type-archive-product, .single-product, .tax-product_cat
) :is(#page,#content,#main,.site-content,#primary,.content-area,.ast-container,
      .entry-content,.ast-article-single,.ast-article-post,.ast-separate-container){
  background:transparent !important; background-color:transparent !important;
  box-shadow:none !important; border:none !important;
  position:relative !important; z-index:1 !important;
}

/* Texte foncé UNIQUEMENT dans le contenu boutique (jamais l'accueil). */
:is(#content,#primary,.entry-content,.site-content) .woocommerce p,
:is(#content,#primary,.entry-content,.site-content) .woocommerce li,
:is(#content,#primary,.entry-content,.site-content) .woocommerce td{ color:#5b6b7d !important; }
:is(#content,#primary,.entry-content,.site-content) .woocommerce h1,
:is(#content,#primary,.entry-content,.site-content) .woocommerce h2,
:is(#content,#primary,.entry-content,.site-content) .woocommerce h3,
.woocommerce .product_title{ color:#0a2942 !important; font-weight:900 !important; letter-spacing:-.6px; }
.woocommerce a{ color:#1b9fd1; text-decoration:none !important; }
.woocommerce a:hover{ color:#45cdf2; }

/* ====================  BANNIÈRE DE TITRE  ========================== */
/* .woocommerce-products-header = spécifique Woo (sans risque). Le titre */
/* d'archive Astra est limité aux pages produits (jamais le blog).       */
.woocommerce-products-header,
body.post-type-archive-product .ast-archive-description,
body.tax-product_cat .ast-archive-description,
body.woocommerce-cart .entry-header,
body.woocommerce-checkout .entry-header{
  background:linear-gradient(135deg,#061726 0%,#0a2942 64%,#1b9fd1 138%) !important;
  border-radius:20px !important; padding:30px 44px !important; margin:0 0 30px !important;
  position:relative !important; overflow:hidden !important; z-index:1;
  box-shadow:0 20px 50px rgba(10,22,40,.26) !important; border:1px solid rgba(255,255,255,.06) !important; text-align:left !important;
}
.woocommerce-products-header::before,
body.post-type-archive-product .ast-archive-description::before,
body.tax-product_cat .ast-archive-description::before,
body.woocommerce-cart .entry-header::before,
body.woocommerce-checkout .entry-header::before{
  content:''; position:absolute; inset:0; pointer-events:none;
  background:
    radial-gradient(520px 360px at 92% -18%, rgba(53,198,240,.38), transparent 60%),
    radial-gradient(440px 340px at -4% 130%, rgba(46,182,230,.30), transparent 60%);
}
.woocommerce-products-header__title,
body.post-type-archive-product .ast-archive-description .ast-archive-title,
body.tax-product_cat .ast-archive-description .ast-archive-title,
body.woocommerce-cart .entry-header .entry-title,
body.woocommerce-checkout .entry-header .entry-title{
  color:#fff !important; position:relative; z-index:1; margin:0 !important;
  font-size:clamp(26px,3vw,40px) !important; font-weight:900 !important; letter-spacing:-1.2px; text-shadow:0 2px 30px rgba(0,0,0,.25);
}
.woocommerce-products-header__title::before,
body.post-type-archive-product .ast-archive-title::before,
body.tax-product_cat .ast-archive-title::before{
  content:'BOUTIQUE — LOCATION ÉVÉNEMENTIELLE'; display:block; font-size:11px; font-weight:800; letter-spacing:4px; color:#35c6f0; margin-bottom:10px; text-shadow:none;
}
body.woocommerce-cart .entry-header .entry-title::before{ content:'PANIER'; display:block; font-size:11px; font-weight:800; letter-spacing:4px; color:#35c6f0; margin-bottom:14px; text-shadow:none; }
body.woocommerce-checkout .entry-header .entry-title::before{ content:'FINALISER LA COMMANDE'; display:block; font-size:11px; font-weight:800; letter-spacing:4px; color:#35c6f0; margin-bottom:14px; text-shadow:none; }
.woocommerce-products-header__title::after,
body.post-type-archive-product .ast-archive-title::after,
body.tax-product_cat .ast-archive-title::after,
body.woocommerce-cart .entry-header .entry-title::after,
body.woocommerce-checkout .entry-header .entry-title::after{
  content:''; display:block; width:60px; height:4px; margin-top:12px; background:linear-gradient(90deg,#35c6f0,#1b9fd1); border-radius:3px; box-shadow:0 4px 14px rgba(53,198,240,.5);
}
.woocommerce-products-header .term-description,
body.post-type-archive-product .ast-archive-description-meta,
body.tax-product_cat .ast-archive-description-meta{ color:#c3d4e6 !important; position:relative; z-index:1; max-width:660px; line-height:1.7; }

/* bande de réassurance optionnelle (bloc HTML) */
.es-trust{ display:flex; gap:14px; flex-wrap:wrap; justify-content:center; position:relative; z-index:1;
  background:linear-gradient(180deg,#fff,#FAFCFF); border:1px solid #E3EDFB; border-radius:16px; padding:18px 22px; margin:0 0 30px; box-shadow:0 8px 22px rgba(10,22,40,.06); }
.es-trust span{ color:#5b6b7d; font-weight:600; font-size:14px; display:flex; align-items:center; gap:8px; }
.es-trust span::before{ content:'✓'; display:inline-flex; align-items:center; justify-content:center; width:22px; height:22px; border-radius:50%; background:linear-gradient(135deg,#1b9fd1,#2eb6e6); color:#fff; font-size:11px; font-weight:900; box-shadow:0 4px 10px rgba(46,182,230,.3); }
.es-trust b{ color:#0a2942; }

/* ====================  BARRE TRI / RÉSULTATS  ====================== */
/* Barre alignée : nombre de résultats à GAUCHE, menu de tri à DROITE.   */
/* (avant le select se retrouvait centré au milieu de la page)           */
.woocommerce .woocommerce-result-count{
  color:#5b6b7d !important; font-weight:600; font-size:14px;
  float:left !important; margin:0 !important; line-height:50px !important;
}
.woocommerce .woocommerce-ordering{
  float:right !important; margin:0 !important; overflow:visible !important; display:block !important; text-align:right !important; clear:none !important;
}
/* on remet une marge sous toute la barre + on nettoie les flottants */
.woocommerce-products-header + .woocommerce-result-count,
.woocommerce .woocommerce-result-count,
.woocommerce .woocommerce-ordering{ margin-bottom:18px !important; }
.woocommerce ul.products{ clear:both !important; }
.woocommerce .woocommerce-ordering select,.woocommerce-page select.orderby{
  width:auto !important; min-width:260px !important; max-width:100% !important;
  height:auto !important; min-height:50px !important; line-height:1.2 !important; box-sizing:border-box !important;
  white-space:nowrap !important; text-overflow:ellipsis !important; vertical-align:middle !important;
  background:#fff !important; border:1.5px solid #dde5ec !important; color:#0a2942 !important; border-radius:12px !important; padding:0 48px 0 18px !important; font-weight:600 !important; font-size:14px !important; font-family:inherit !important;
  box-shadow:0 4px 14px rgba(10,22,40,.06) !important; appearance:none; -webkit-appearance:none; -moz-appearance:none; cursor:pointer;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='%231E6FD9' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>") !important;
  background-repeat:no-repeat !important; background-position:right 16px center !important; transition:border-color .2s, box-shadow .2s;
}
.woocommerce .woocommerce-ordering select:focus,.woocommerce-page select.orderby:focus{ outline:none !important; border-color:#1b9fd1 !important; box-shadow:0 0 0 4px rgba(46,182,230,.12) !important; }
.woocommerce .woocommerce-breadcrumb{ color:#5b6b7d !important; margin-bottom:18px; font-size:13px; position:relative; z-index:1; }
.woocommerce .woocommerce-breadcrumb a{ color:#1b9fd1; font-weight:600; }

/* ====================  GRILLE : ORDRE + TAILLES  =================== */
.woocommerce ul.products,.woocommerce-page ul.products{ display:flex !important; flex-wrap:wrap; gap:30px; margin:0 0 44px !important; padding:0 !important; align-items:stretch; position:relative; z-index:1; }
/* Cartes plus GRANDES : 3 par ligne sur grand écran pour mieux voir les   */
/* produits. Regroupement par catégorie conservé via "order".             */
.woocommerce ul.products li.product{
  margin:0 !important; float:none !important; display:flex; flex-direction:column;
  flex:0 0 calc(33.333% - 20px) !important; max-width:calc(33.333% - 20px) !important; width:auto !important;
}
.woocommerce ul.products li.product[class*="product_cat-pack"]{ order:1; }
.woocommerce ul.products li.product[class*="product_cat-machine"],
.woocommerce ul.products li.product[class*="product_cat-fontaine"],
.woocommerce ul.products li.product[class*="product_cat-refrig"],
.woocommerce ul.products li.product[class*="product_cat-mobilier"]{ order:2; }
.woocommerce ul.products li.product[class*="product_cat-suppl"]{ order:3; }
@media(max-width:1100px){ .woocommerce ul.products li.product{ flex:0 0 calc(50% - 15px) !important; max-width:calc(50% - 15px) !important; } }
@media(max-width:600px){ .woocommerce ul.products li.product{ flex:0 0 100% !important; max-width:100% !important; } }

/* ====================  CARTE PRODUIT (premium)  ==================== */
.woocommerce ul.products li.product{
  position:relative !important; background:linear-gradient(180deg,#FFFFFF 0%,#FBFDFF 100%) !important; border:1.5px solid #dde5ec !important; border-radius:22px !important;
  padding:0 0 18px !important; overflow:hidden !important; text-align:center; box-shadow:0 16px 38px rgba(10,41,66,.13) !important;
  transition:transform .4s var(--es-ease), box-shadow .4s var(--es-ease), border-color .4s !important;
}
.woocommerce ul.products li.product:hover{ transform:translateY(-10px) !important; box-shadow:0 34px 64px rgba(46,182,230,.26) !important; border-color:#9FC2F0 !important; }
.woocommerce ul.products li.product::before{
  content:''; position:absolute; left:0; right:0; top:0; height:4px; background:linear-gradient(90deg,#1b9fd1,#35c6f0,#1b9fd1); background-size:200% 100%;
  opacity:0; transition:opacity .3s ease; z-index:3; animation:esShine 3s linear infinite;
}
.woocommerce ul.products li.product:hover::before{ opacity:1; }
@keyframes esShine{ to{ background-position:200% 0; } }
.woocommerce ul.products li.product a{ display:block; }
/* Zone image avec un joli petit CADRE : panneau légèrement teinté, coins  */
/* arrondis et fine bordure -> l'image ne flotte plus sur du blanc plat.   */
.woocommerce ul.products li.product a img{
  display:block !important; width:calc(100% - 32px) !important; height:240px !important; object-fit:contain !important; object-position:center !important;
  background:linear-gradient(160deg,#EEF5FF 0%,#FFFFFF 70%) !important;
  border:1px solid #E1EBFA !important; border-radius:18px !important; padding:22px !important; margin:16px 16px 14px !important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.9), 0 6px 16px rgba(10,22,40,.06) !important; transition:transform .5s var(--es-ease), box-shadow .3s !important;
}
.woocommerce ul.products li.product:hover a img{ transform:scale(1.05); box-shadow:inset 0 1px 0 rgba(255,255,255,.9), 0 12px 28px rgba(46,182,230,.16) !important; }
/* TITRE : couleur foncée forte, 2 lignes MAX (hauteur exacte = jamais     */
/* coupé en plein milieu), même hauteur pour toutes les cartes.            */
.woocommerce ul.products li.product .woocommerce-loop-product__title,
.woocommerce ul.products li.product h2.woocommerce-loop-product__title,
.woocommerce ul.products li.product .ast-woo-shop-archive-title,
.woocommerce ul.products li.product .ast-woo-product-title{
  color:#0a2942 !important; font-size:16.5px !important; font-weight:800 !important; line-height:1.4 !important;
  padding:4px 20px 6px !important; margin:0 !important; letter-spacing:-.3px; text-align:center;
  display:-webkit-box !important; -webkit-line-clamp:2 !important; -webkit-box-orient:vertical !important; overflow:hidden !important;
  height:2.8em !important; min-height:2.8em !important; max-height:2.8em !important;
  overflow-wrap:break-word; word-break:normal; hyphens:none; text-overflow:ellipsis;
}
/* PRIX : mis en valeur dans une petite zone teintée centrée */
.woocommerce ul.products li.product .price{
  color:#1558B0 !important; font-weight:900 !important; font-size:23px !important; padding:4px 0 !important; margin:2px 20px 0 !important; letter-spacing:-.6px;
  display:block; text-align:center;
}
.woocommerce ul.products li.product .price del{ color:#8ba6c2 !important; font-weight:600; font-size:15px; margin-right:6px; }
.woocommerce ul.products li.product .price ins{ color:#0a2942 !important; text-decoration:none; }
.woocommerce ul.products li.product .button{
  display:block !important; width:calc(100% - 36px); margin:14px 18px 0 !important; margin-top:auto !important; background:linear-gradient(135deg,#1b9fd1,#2eb6e6) !important; color:#fff !important; border:none !important; border-radius:12px !important;
  padding:14px 14px !important; font-weight:800 !important; font-size:14.5px !important; letter-spacing:.2px; box-shadow:0 10px 22px rgba(46,182,230,.24) !important; transition:filter .2s, transform .2s, box-shadow .2s !important;
}
.woocommerce ul.products li.product .button:hover{ filter:brightness(1.07); transform:translateY(-2px); box-shadow:0 16px 32px rgba(46,182,230,.34) !important; }

/* ====================  ACTIONS CARTE : PANIER + LIRE LA SUITE  ====== */
/* Conteneur ajouté par eauservice-functions.php : gros bouton "Ajouter   */
/* au panier" + petit bouton "Lire la suite" alignés côte à côte.        */
/* "Ajouter au panier" = gros bouton pleine largeur. "Lire la suite" =    */
/* petit lien DISCRET en bas à droite de la carte.                        */
.woocommerce ul.products li.product .es-loop-actions{
  display:block !important; width:calc(100% - 36px); margin:14px 18px 2px !important; margin-top:auto !important; text-align:right;
}
.woocommerce ul.products li.product .es-loop-actions .button{
  display:flex !important; align-items:center !important; justify-content:center !important;
  width:100% !important; height:46px !important; min-height:0 !important; line-height:1 !important;
  margin:0 !important; padding:0 16px !important; border-radius:12px !important; font-size:14px !important; white-space:nowrap;
  overflow:hidden; text-overflow:ellipsis;
}
.woocommerce ul.products li.product .es-loop-readmore{
  display:inline-block; margin:8px 2px 0 !important; padding:7px 16px !important;
  background:#e7f7fe !important; border:1.5px solid #C9DDF7 !important; box-shadow:0 2px 6px rgba(46,182,230,.10) !important; border-radius:30px !important;
  color:#1558B0 !important; font-size:12.5px !important; font-weight:800 !important; text-decoration:none !important; letter-spacing:.2px;
  transition:background .2s, color .2s, transform .2s;
}
.woocommerce ul.products li.product .es-loop-readmore:hover{ background:#1b9fd1 !important; color:#fff !important; border-color:#1b9fd1 !important; transform:translateY(-2px); }

/* CALIBRAGE : quand "Lire la suite" est SEUL (produit sans prix), on évite
   le gros bouton pleine largeur disproportionné -> bouton secondaire,
   largeur auto, centré et de taille normale. */
.woocommerce ul.products li.product a.button.product_type_simple:not(.add_to_cart_button),
.woocommerce ul.products li.product a.button.product_type_grouped:not(.add_to_cart_button),
.woocommerce ul.products li.product .es-loop-actions a.button:only-child{
  display:inline-block !important; width:auto !important; max-width:calc(100% - 36px);
  margin:14px auto 0 !important; margin-top:auto !important;
  padding:12px 24px !important; font-size:13.5px !important;
  background:#e7f7fe !important; color:#1b9fd1 !important; border:1.5px solid #dde5ec !important; box-shadow:none !important;
}
.woocommerce ul.products li.product a.button.product_type_simple:not(.add_to_cart_button):hover,
.woocommerce ul.products li.product .es-loop-actions a.button:only-child:hover{
  background:#DCE9FB !important; color:#1558B0 !important; transform:translateY(-2px); filter:none;
}

/* Bouton "Retour à la boutique" sur la fiche produit */
.woocommerce div.product .es-back-to-shop{
  display:inline-flex; align-items:center; gap:6px; margin:0 0 18px; padding:10px 18px; border-radius:11px;
  background:#e7f7fe !important; color:#1b9fd1 !important; font-weight:700 !important; font-size:14px; border:1.5px solid #dde5ec !important;
  transition:background .2s, transform .2s;
}
.woocommerce div.product .es-back-to-shop:hover{ background:#DCE9FB !important; transform:translateX(-3px); }
.woocommerce span.onsale{
  background:linear-gradient(135deg,#22C55E,#16a34a) !important; color:#fff !important; border-radius:30px !important; font-weight:800 !important; font-size:11px !important; padding:6px 14px !important; line-height:1 !important;
  min-height:auto !important; min-width:auto !important; top:16px !important; left:16px !important; right:auto !important; box-shadow:0 8px 18px rgba(34,197,94,.34); z-index:4; letter-spacing:.3px;
}
.woocommerce ul.products li.product.featured{ border-color:#1b9fd1 !important; box-shadow:0 24px 50px rgba(46,182,230,.22) !important; }
.woocommerce ul.products li.product.featured::after{
  content:'★ POPULAIRE'; position:absolute; top:16px; right:16px; z-index:4; background:linear-gradient(135deg,#1b9fd1,#2eb6e6); color:#fff; font-size:10px; font-weight:800; letter-spacing:.5px; padding:6px 12px; border-radius:30px; box-shadow:0 8px 18px rgba(46,182,230,.4);
}
@keyframes esRise{ from{opacity:0;transform:translateY(20px);} to{opacity:1;transform:none;} }
.woocommerce ul.products li.product{ animation:esRise .55s var(--es-ease) both; }
.woocommerce ul.products li.product:nth-child(2){animation-delay:.05s}
.woocommerce ul.products li.product:nth-child(3){animation-delay:.10s}
