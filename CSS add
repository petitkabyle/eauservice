}
.es-pay .es-pay-ico{
  flex:0 0 auto; font-size:24px; line-height:1.1;
}
.es-pay .es-pay-txt{ flex:1 1 auto; min-width:0; }
.es-pay .es-pay-t{
  display:block; color:#0a2942 !important; font-size:15px; font-weight:800;
  line-height:1.35; margin:0 0 5px;
}
.es-pay .es-pay-d{
  display:block; color:#40566e; font-size:13.5px; line-height:1.6;
}
.es-pay .es-pay-d strong{ color:#12855a; }

/* Sur la page de commande, le bandeau est dans la colonne de droite :   */
/* on resserre un peu pour ne pas pousser le bouton de paiement trop bas.*/
body.woocommerce-checkout #order_review .es-pay,
body.woocommerce-checkout .woocommerce-checkout-review-order .es-pay{
  margin:0 0 14px; padding:13px 16px; border-radius:13px;
}
body.woocommerce-checkout #order_review .es-pay .es-pay-t{ font-size:14px; }
body.woocommerce-checkout #order_review .es-pay .es-pay-d{ font-size:12.5px; }

/* Sur la fiche produit, le bandeau suit le bouton d'ajout au panier.    */
body.single-product .es-pay{ margin:16px 0 0; }

@media(max-width:600px){
  .es-pay{ padding:14px 16px; border-radius:13px; gap:11px; }
  .es-pay .es-pay-ico{ font-size:20px; }
  .es-pay .es-pay-t{ font-size:14px; }
  .es-pay .es-pay-d{ font-size:13px; }
}
