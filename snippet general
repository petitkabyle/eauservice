/* ===========================================================================
 * 15) FRAIS DE LIVRAISON — PILOTÉS PAR LA ZONE CHOISIE AU CHECKOUT
 *     ------------------------------------------------------------------
 *     Les frais dépendent UNIQUEMENT du menu déroulant « Zone de livraison »
 *     (section 6). Le code postal et la ville de FACTURATION ne sont plus
 *     lus du tout : changer l adresse de facturation ne modifie plus rien.
 *
 *     Pour ajuster un tarif : modifiez eauservice_delivery_zones() (section 6).
 * =========================================================================== */

/**
 * Récupère la zone choisie par le client.
 * Ordre de lecture : POST direct (validation) > post_data (AJAX du checkout)
 * > session WooCommerce (mémorisation entre deux rafraîchissements).
 */
function eauservice_get_selected_delivery_zone() {
	$zone  = '';
	$found = false;

	if ( isset( $_POST['es_delivery_zone'] ) ) {
		$zone  = sanitize_text_field( wp_unslash( $_POST['es_delivery_zone'] ) );
		$found = true;
	} elseif ( isset( $_POST['post_data'] ) ) {
		$parsed = array();
		parse_str( wp_unslash( $_POST['post_data'] ), $parsed );
		if ( isset( $parsed['es_delivery_zone'] ) ) {
			$zone  = sanitize_text_field( $parsed['es_delivery_zone'] );
			$found = true;
		}
	}

	// Le client vient de choisir (ou de vider) la zone : on mémorise son choix.
	if ( $found ) {
		if ( function_exists( 'WC' ) && WC()->session ) {
			WC()->session->set( 'es_delivery_zone', $zone );
		}
		return $zone;
	}

	// Sinon on relit le dernier choix mémorisé.
	if ( function_exists( 'WC' ) && WC()->session ) {
		$stored = WC()->session->get( 'es_delivery_zone' );
		if ( ! empty( $stored ) ) {
			return (string) $stored;
		}
	}

	return '';
}

// 15a. Application automatique des frais au panier / checkout.
add_action( 'woocommerce_cart_calculate_fees', 'eauservice_appliquer_frais_livraison', 20 );
function eauservice_appliquer_frais_livraison( $cart ) {
	if ( is_admin() && ! defined( 'DOING_AJAX' ) ) {
		return;
	}
	if ( ! function_exists( 'WC' ) ) {
		return;
	}

	$zone_key = eauservice_get_selected_delivery_zone();
	if ( '' === $zone_key ) {
		return; // Aucune zone choisie : aucun frais ajouté.
	}

	$zones = eauservice_delivery_zones();
	if ( ! isset( $zones[ $zone_key ] ) ) {
		return;
	}

	$zone = $zones[ $zone_key ];
	if ( 0 == $zone['montant'] ) {
		return; // Antibes : livraison offerte, rien à ajouter au total.
	}

	// WooCommerce vide les frais avant chaque appel de ce hook : pas de doublon.
	$cart->add_fee( $zone['libelle'], (float) $zone['montant'], false );
}

// 15b. Rappel au checkout : zone retenue + contact pour les cas particuliers.
add_action( 'woocommerce_review_order_before_payment', 'eauservice_note_livraison' );
