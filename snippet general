	if ( '' !== $zone_key && isset( $zones[ $zone_key ] ) ) {
		$zone    = $zones[ $zone_key ];
		$montant = ( 0 == $zone['montant'] ) ? 'livraison offerte' : $zone['montant'] . ' €';
		$info    = 'Zone retenue : <strong>' . esc_html( $zone['label'] ) . '</strong> — ' . esc_html( $montant ) . '.';
