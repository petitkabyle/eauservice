// 6b. Validation des champs obligatoires.
add_action( 'woocommerce_checkout_process', 'eauservice_validate_event_fields' );
function eauservice_validate_event_fields() {
	$zones = eauservice_delivery_zones();
	$zone  = isset( $_POST['es_delivery_zone'] ) ? sanitize_text_field( wp_unslash( $_POST['es_delivery_zone'] ) ) : '';

	if ( '' === $zone || ! isset( $zones[ $zone ] ) ) {
		wc_add_notice( 'Merci de choisir votre zone de livraison.', 'error' );
	}

	$required = array(
		'es_venue_address'  => 'Adresse exacte de livraison',
		'es_onsite_contact' => 'Contact sur place (nom)',
		'es_onsite_phone'   => 'Téléphone du contact sur place',
		'es_delivery_date'  => 'Date de livraison',
		'es_pickup_date'    => 'Date de reprise',
	);
	foreach ( $required as $key => $label ) {
		if ( empty( $_POST[ $key ] ) ) {
			wc_add_notice( sprintf( 'Merci de renseigner : %s.', $label ), 'error' );
		}
	}
}

// 6c. Enregistrement dans la commande (compatible stockage classique + HPOS).
add_action( 'woocommerce_checkout_create_order', 'eauservice_save_event_fields', 20, 2 );
function eauservice_save_event_fields( $order, $data ) {
	$textareas = array( 'es_access_notes', 'es_extra_notes' );
	foreach ( array_keys( eauservice_event_fields_list() ) as $key ) {
		if ( ! empty( $_POST[ $key ] ) ) {
			$value = in_array( $key, $textareas, true )
				? sanitize_textarea_field( wp_unslash( $_POST[ $key ] ) )
				: sanitize_text_field( wp_unslash( $_POST[ $key ] ) );
			$order->update_meta_data( '_' . $key, $value );
		}
	}
}

/** Transforme la clé de zone en libellé lisible pour l affichage. */
function eauservice_format_event_field_value( $key, $value ) {
	if ( 'es_delivery_zone' !== $key ) {
		return $value;
	}
	$zones = eauservice_delivery_zones();
	if ( ! isset( $zones[ $value ] ) ) {
		return $value;
	}
	$zone   = $zones[ $value ];
	$suffix = ( 0 == $zone['montant'] ) ? 'livraison offerte' : $zone['montant'] . ' €';
	return $zone['label'] . ' (' . $suffix . ')';
}

