/* ===========================================================================
 * 15) FRAIS DE LIVRAISON PAR CODE POSTAL (tarifs fixes par ville)
 *     Applique des tarifs fixes selon le code postal / la ville :
 *     >>> TARIFS PAR VILLE :
 *       Antibes (06600, 06160) = GRATUIT
 *       Cannes (06400, 06150, 06110, 06210, 06220, 06590) = 30 €
 *       Nice (06000, 06100, 06200, 06300) = 50 €
 *       Monaco (98000, 98xxx) = 50 €
 *       Autres villes Alpes-Maritimes (06xxx) = 80 €
 *       Var (83xxx) = 100 €
 *       Autres départements = 200 €
 *     
 *     Le système reconnaît automatiquement la ville via le code postal.
 *     Si besoin d'ajuster : modifiez la fonction eauservice_get_tarif_livraison()
 * =========================================================================== */

/**
 * Détermine les frais de livraison selon le code postal
 * @param string $cp Code postal du client
 * @param string $ville Ville du client (utilisée comme secours si code postal ambigu)
 * @return array ['montant' => float, 'libelle' => string]
 */
function eauservice_get_tarif_livraison( $cp, $ville = '' ) {
	// Normaliser le code postal (retirer espaces, garder que les chiffres)
	$cp_clean = preg_replace( '/\D/', '', (string) $cp );
	$cp5 = substr( $cp_clean, 0, 5 );
	
	// Normaliser la ville pour comparaison
	$ville_lower = function_exists('mb_strtolower') ? mb_strtolower( trim( $ville ) ) : strtolower( trim( $ville ) );
	
	// ===== ANTIBES = GRATUIT =====
	$codes_antibes = array( '06600', '06160' );
	if ( in_array( $cp5, $codes_antibes, true ) ) {
		return array( 'montant' => 0, 'libelle' => 'Livraison offerte (Antibes)' );
	}
	if ( false !== strpos( $ville_lower, 'antibes' ) || false !== strpos( $ville_lower, 'juan' ) ) {
		return array( 'montant' => 0, 'libelle' => 'Livraison offerte (Antibes)' );
	}
	
	// ===== CANNES = 30 € =====
	$codes_cannes = array( '06400', '06150', '06110', '06210', '06220', '06590' );
	if ( in_array( $cp5, $codes_cannes, true ) ) {
		return array( 'montant' => 30, 'libelle' => 'Frais de livraison & installation (Cannes)' );
	}
	if ( false !== strpos( $ville_lower, 'cannes' ) || false !== strpos( $ville_lower, 'croisette' ) || 
	     false !== strpos( $ville_lower, 'mougins' ) || false !== strpos( $ville_lower, 'mandelieu' ) ) {
		return array( 'montant' => 30, 'libelle' => 'Frais de livraison & installation (Cannes)' );
	}
	
	// ===== NICE = 50 € =====
	$codes_nice = array( '06000', '06100', '06200', '06300' );
	if ( in_array( $cp5, $codes_nice, true ) ) {
		return array( 'montant' => 50, 'libelle' => 'Frais de livraison & installation (Nice)' );
	}
	if ( false !== strpos( $ville_lower, 'nice' ) || false !== strpos( $ville_lower, 'nissa' ) ) {
		return array( 'montant' => 50, 'libelle' => 'Frais de livraison & installation (Nice)' );
	}
	
	// ===== MONACO = 100 € (MODIFIÉ) =====
	if ( '98' === substr( $cp5, 0, 2 ) || '98000' === $cp5 ) {
		return array( 'montant' => 100, 'libelle' => 'Frais de livraison & installation (Monaco)' );
	}
	if ( false !== strpos( $ville_lower, 'monaco' ) || false !== strpos( $ville_lower, 'monte' ) || 
	     false !== strpos( $ville_lower, 'carlo' ) ) {
		return array( 'montant' => 100, 'libelle' => 'Frais de livraison & installation (Monaco)' );
	}
	
	// ===== SAINT-TROPEZ = 150 € (AJOUTÉ) =====
	$codes_st_tropez = array( '83990', '83350', '83580' );
	if ( in_array( $cp5, $codes_st_tropez, true ) ) {
		return array( 'montant' => 150, 'libelle' => 'Frais de livraison & installation (Saint-Tropez)' );
	}
	if ( false !== strpos( $ville_lower, 'tropez' ) || false !== strpos( $ville_lower, 'st-tropez' ) ||
	     false !== strpos( $ville_lower, 'saint-tropez' ) || false !== strpos( $ville_lower, 'ramatuelle' ) ||
	     false !== strpos( $ville_lower, 'gassin' ) ) {
		return array( 'montant' => 150, 'libelle' => 'Frais de livraison & installation (Saint-Tropez)' );
	}
	
	// ===== AUTRES VILLES ALPES-MARITIMES (06) = 80 € =====
	if ( '06' === substr( $cp5, 0, 2 ) ) {
		return array( 'montant' => 80, 'libelle' => 'Frais de livraison & installation (Alpes-Maritimes)' );
	}
	
	// ===== VAR (83) = 100 € =====
	if ( '83' === substr( $cp5, 0, 2 ) ) {
		return array( 'montant' => 100, 'libelle' => 'Frais de livraison & installation (Var)' );
	}
	
	// ===== AUTRES DÉPARTEMENTS = 150 € (MODIFIÉ - MAX) =====
	if ( strlen( $cp5 ) === 5 ) {
		return array( 'montant' => 150, 'libelle' => 'Frais de livraison & installation' );
	}
	
	// ===== AUCUN CODE POSTAL VALIDE = PAS DE FRAIS (sera calculé au checkout) =====
	return array( 'montant' => null, 'libelle' => '' );
}

// 15a. Application automatique des frais au panier / checkout.
// UTILISE LES CHAMPS PERSONNALISÉS es_delivery_postcode et es_delivery_city
add_action( 'woocommerce_cart_calculate_fees', 'eauservice_appliquer_frais_livraison', 10 );
function eauservice_appliquer_frais_livraison( $cart ) {
	if ( is_admin() && ! defined( 'DOING_AJAX' ) ) { 
		return; 
	}
	
	// Récupérer le code postal et la ville depuis les champs personnalisés
	// Ces champs sont remplis dans la section "Informations de livraison"
	$cp    = isset( $_POST['es_delivery_postcode'] ) ? trim( sanitize_text_field( $_POST['es_delivery_postcode'] ) ) : '';
	$ville = isset( $_POST['es_delivery_city'] ) ? trim( sanitize_text_field( $_POST['es_delivery_city'] ) ) : '';
	
	// Si vides, ne rien faire (pas de frais)
	if ( empty( $cp ) || strlen( $cp ) < 5 ) {
		return;
	}
	
	// Calculer le tarif selon le code postal
	$tarif = eauservice_get_tarif_livraison( $cp, $ville );
	
	// Si pas de tarif trouvé (null), ne rien ajouter
	if ( null === $tarif['montant'] ) {
		return;
	}
	
	// Ajouter les frais calculés
	$cart->add_fee( $tarif['libelle'], $tarif['montant'], false );
}

