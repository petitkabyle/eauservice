// 6b. Validation
add_action( 'woocommerce_checkout_process', 'eauservice_validate_event_fields' );
function eauservice_validate_event_fields() {
	if ( empty( $_POST['es_delivery_postcode'] ) ) {
		wc_add_notice( 'Le code postal de livraison est obligatoire', 'error' );
	} elseif ( ! preg_match( '/^[0-9]{5}$/', $_POST['es_delivery_postcode'] ) ) {
		wc_add_notice( 'Le code postal doit contenir 5 chiffres', 'error' );
	}
	
	if ( empty( $_POST['es_delivery_city'] ) ) {
		wc_add_notice( 'La ville de livraison est obligatoire', 'error' );
	}
	
	if ( empty( $_POST['es_venue_address'] ) ) {
		wc_add_notice( 'L\'adresse est obligatoire', 'error' );
	}
	
	if ( empty( $_POST['es_delivery_date'] ) ) {
		wc_add_notice( 'La date de livraison est obligatoire', 'error' );
	}
	
	if ( empty( $_POST['es_onsite_contact'] ) ) {
		wc_add_notice( 'Le contact sur place est obligatoire', 'error' );
	}
	
	if ( empty( $_POST['es_onsite_phone'] ) ) {
		wc_add_notice( 'Le téléphone est obligatoire', 'error' );
	}
}

