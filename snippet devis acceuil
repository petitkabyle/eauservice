/**
 * ============================================================================
 *  EAUSERVICE — Traitement du formulaire « Demander un devis » (accueil)
 *  ---------------------------------------------------------------------------
 *  À COLLER DANS : Code Snippets > Ajouter un snippet
 *  Type « Functions (PHP) » + « Exécuter partout », sans balise d ouverture PHP.
 *
 *  POUR CHANGER LES ADRESSES QUI RECOIVENT LES DEVIS :
 *  une seule chose à modifier, la liste dans eauservice_devis_destinataires().
 * ============================================================================
 */

if ( ! defined( 'ABSPATH' ) ) { exit; }

/**
 * Adresses qui recoivent les demandes de devis.
 *
 * Chaque adresse recoit son PROPRE e-mail : si l une des boites est en panne,
 * pleine ou mal orthographiee, les autres sont livrees quand meme.
 *
 * Pour retirer une adresse : supprimez simplement sa ligne.
 * Pour en ajouter une : ajoutez une ligne sur le meme modele.
 *
 * Historique : cette liste pointait vers une adresse sur un domaine en .fr
 * qui n existe pas, sans aucun enregistrement MX. Les journaux YaySMTP
 * affichaient « Success » parce que le serveur d envoi acceptait le message,
 * mais celui-ci rebondissait ensuite dans le vide. C est la raison pour
 * laquelle aucune demande de devis n arrivait, pas meme dans les indesirables.
 *
 * @return array Liste d adresses valides, sans doublon.
 */
function eauservice_devis_destinataires() {
	$destinataires = array(
		'contact@eau-service-events.fr', // boite pro, sur le domaine du site
		'soane.mansouri@gmail.com',      // copie personnelle
	);

	// On ecarte les doublons et toute adresse mal formee.
	$destinataires = array_filter( array_unique( $destinataires ), 'is_email' );

	return array_values( $destinataires );
}

/**
 * Journalise les echecs d envoi, tous expediteurs confondus.
 * Les messages apparaissent dans le journal d erreurs de WordPress
 * (wp-content/debug.log si WP_DEBUG_LOG est actif).
 */
add_action( 'wp_mail_failed', 'eauservice_journaliser_echec_mail' );
function eauservice_journaliser_echec_mail( $erreur ) {
	if ( is_wp_error( $erreur ) ) {
		error_log( 'EauService — envoi e-mail en echec : ' . $erreur->get_error_message() );
	}
}

/**
 * Limite le nombre de demandes envoyees depuis une meme adresse IP.
 * ---------------------------------------------------------------------------
 * POURQUOI : admin-post.php est une porte d entree publique. Sans limite, un
 * robot peut la solliciter en boucle et noyer la boite contact@ sous des
 * centaines de faux devis — et, au passage, faire blacklister votre domaine
 * d envoi pour volume anormal. Le piege a robots (champ cache) arrete les
 * robots les plus simples, pas ceux qui reproduisent une vraie soumission.
 *
 * REGLAGE : 4 demandes par tranche de 30 minutes. C est large pour un humain
 * (meme quelqu un qui se trompe et recommence), et court pour un robot.
 *
 * @return bool true si la limite est atteinte.
 */
function eauservice_devis_limite_atteinte() {
	$ip = isset( $_SERVER['REMOTE_ADDR'] ) ? sanitize_text_field( wp_unslash( $_SERVER['REMOTE_ADDR'] ) ) : '';
	if ( '' === $ip ) { return false; } // IP indisponible : on ne bloque personne.

	// On ne stocke pas l IP en clair, seulement une empreinte : rien
	// d identifiant ne traine dans la base au-dela de la duree utile.
	$cle    = 'es_devis_' . md5( $ip . wp_salt() );
	$nombre = (int) get_transient( $cle );

	if ( $nombre >= 4 ) {
		return true;
	}

	// Le transient expire tout seul au bout de 30 minutes.
	set_transient( $cle, $nombre + 1, 30 * MINUTE_IN_SECONDS );
	return false;
}

/*
 * NOTE SUR L ABSENCE DE NONCE (jeton anti-CSRF).
 * ---------------------------------------------------------------------------
 * Un nonce WordPress se genere en PHP. Or le formulaire vit dans un bloc
 * « HTML personnalise » de la page d accueil, qui n execute pas de PHP : il
 * est donc impossible d y inserer un wp_nonce_field(). Ce n est pas grave ici :
 * le pire qu un CSRF permette sur ce formulaire, c est de vous envoyer une
 * demande de devis, ce que n importe qui peut deja faire legitimement. Aucune
 * donnee n est modifiee, aucun compte n est concerne.
 * Les vraies protections utiles sont donc celles mises en place : piege a
 * robots, verification de provenance, et limitation de debit.
 * Si le spam devenait un probleme malgre tout, la bonne reponse serait de
 * passer le formulaire sur une extension dediee (Fluent Forms, WPForms), qui
 * gere nonce, captcha et journal des envois.
 */
add_action( 'admin_post_eauservice_devis', 'eauservice_devis_handle' );
add_action( 'admin_post_nopriv_eauservice_devis', 'eauservice_devis_handle' );
function eauservice_devis_handle() {
	$home = home_url( '/' );
	$back = wp_get_referer() ? wp_get_referer() : $home;

	// Piege a robots : le champ cache doit rester vide.
	if ( ! empty( $_POST['es_website'] ) ) { wp_safe_redirect( add_query_arg( 'es_devis', 'spam', $back ) . '#es-devis' ); exit; }

	/*
	 * Le formulaire doit venir de ce site.
	 * CORRECTION : avant, l absence d en-tete Referer laissait passer la
	 * requete (« if ( $ref && ... ) »). Or un robot n envoie justement pas cet
	 * en-tete : la verification etait contournable en ne fournissant rien.
	 * Desormais le referer est obligatoire ET doit correspondre au domaine.
	 */
	$ref      = wp_get_referer();
	$hote_ref = $ref ? wp_parse_url( $ref, PHP_URL_HOST ) : '';
	if ( ! $hote_ref || $hote_ref !== wp_parse_url( $home, PHP_URL_HOST ) ) {
		wp_safe_redirect( add_query_arg( 'es_devis', 'spam', $home ) . '#es-devis' );
		exit;
	}

	// Limitation de debit par adresse IP.
	if ( eauservice_devis_limite_atteinte() ) {
		wp_safe_redirect( add_query_arg( 'es_devis', 'trop', $back ) . '#es-devis' );
		exit;
	}

	$nom     = isset( $_POST['es_nom'] )     ? sanitize_text_field( wp_unslash( $_POST['es_nom'] ) )     : '';
	$email   = isset( $_POST['es_email'] )   ? sanitize_email( wp_unslash( $_POST['es_email'] ) )         : '';
	$tel     = isset( $_POST['es_tel'] )     ? sanitize_text_field( wp_unslash( $_POST['es_tel'] ) )     : '';
	$date    = isset( $_POST['es_date'] )    ? sanitize_text_field( wp_unslash( $_POST['es_date'] ) )    : '';
	$event   = isset( $_POST['es_event'] )   ? sanitize_text_field( wp_unslash( $_POST['es_event'] ) )   : '';
	$message = isset( $_POST['es_message'] ) ? sanitize_textarea_field( wp_unslash( $_POST['es_message'] ) ) : '';
	// Controles de fond : on veut un nom plausible, un e-mail valide, un
	// telephone contenant de vrais chiffres et un besoin un minimum decrit.
	// Cela ecarte les soumissions automatiques remplies de caracteres au hasard
	// sans jamais gener quelqu un qui ecrit normalement.
	$chiffres_tel = preg_replace( '/\D/', '', $tel );
	$invalide     = ( '' === $nom )
		|| ( mb_strlen( $nom ) < 2 )
		|| ! is_email( $email )
		|| ( strlen( $chiffres_tel ) < 9 )
		|| ( mb_strlen( trim( $message ) ) < 10 );

	if ( $invalide ) { wp_safe_redirect( add_query_arg( 'es_devis', 'err', $back ) . '#es-devis' ); exit; }

	$site   = wp_specialchars_decode( get_bloginfo( 'name' ), ENT_QUOTES );
	$sujet  = 'Nouvelle demande de DEVIS — ' . $nom;
	$lignes = array( 'Nom & prénom' => $nom, 'E-mail' => $email, 'Téléphone' => $tel, 'Date de l’événement' => $date ?: '—', 'Type / lieu' => $event ?: '—' );
	$corps  = '<div style="font-family:Arial,sans-serif;max-width:600px;margin:auto;border:1px solid #e5e9f0;border-radius:10px;overflow:hidden;">';
	$corps .= '<div style="background:#0F2747;color:#fff;padding:18px 22px;font-size:18px;font-weight:bold;">Nouvelle demande de devis</div>';
	$corps .= '<div style="padding:22px;color:#0A1C36;"><table style="width:100%;border-collapse:collapse;font-size:14px;">';
	foreach ( $lignes as $label => $val ) { $corps .= '<tr><td style="padding:7px 10px;border:1px solid #eef2f7;background:#f6f9fc;font-weight:bold;width:40%;">' . esc_html( $label ) . '</td><td style="padding:7px 10px;border:1px solid #eef2f7;">' . esc_html( $val ) . '</td></tr>'; }
	$corps .= '</table><p style="margin:18px 0 6px;font-weight:bold;color:#0F2747;">Besoin / message :</p>';
	$corps .= '<p style="margin:0;padding:14px;background:#f6f9fc;border-radius:8px;white-space:pre-wrap;line-height:1.6;">' . nl2br( esc_html( $message ) ) . '</p></div></div>';

	/*
	 * EXPÉDITEUR : on ne l impose PAS.
	 * -------------------------------------------------------------------
	 * L ancienne version forçait « From: no-reply@<domaine du site> ».
	 * Quand les e-mails partent par YaySMTP, l expediteur doit correspondre
	 * au domaine authentifie par le service d envoi (SPF / DKIM / DMARC).
	 * Un expediteur different est une cause classique de message accepte par
	 * le serveur, visible dans les journaux, puis rejete silencieusement par
	 * la boite du destinataire — Gmail en particulier.
	 *
	 * En ne mettant pas d en-tete From, c est l adresse configuree dans
	 * YaySMTP qui est utilisee : celle qui est justement autorisee.
	 *
	 * RECOMMANDATION : dans les reglages de YaySMTP, mettez comme expediteur
	 * une adresse du domaine du site, par exemple contact@eau-service-events.fr
	 * ou no-reply@eau-service-events.fr. Un expediteur et un destinataire sur
	 * un domaine reellement existant, c est ce qui garantit la delivrabilite.
	 *
	 * Si vous voulez imposer l expediteur depuis ce code plutot que depuis
	 * YaySMTP, definissez la constante EAUSERVICE_DEVIS_FROM avec une adresse
	 * de votre domaine d envoi.
	 */
	// On retire des caracteres qui ont un sens dans un en-tete e-mail, pour que
	// le nom du prospect ne puisse ni creer une ligne d en-tete (retour chariot)
	// ni ressembler a une directive du type « Bcc: ».
	$nom_entete = trim( preg_replace( '/[\r\n,<>";:]+/', ' ', $nom ) );
	$nom_entete = trim( preg_replace( '/\s+/', ' ', $nom_entete ) );
	$headers    = array(
		'Content-Type: text/html; charset=UTF-8',
		'Reply-To: "' . $nom_entete . '" <' . $email . '>',
	);
	if ( defined( 'EAUSERVICE_DEVIS_FROM' ) && is_email( EAUSERVICE_DEVIS_FROM ) ) {
		$headers[] = 'From: ' . $site . ' <' . EAUSERVICE_DEVIS_FROM . '>';
	}

	// Un envoi par destinataire : un echec n empeche pas les autres.
	$destinataires = eauservice_devis_destinataires();
	if ( empty( $destinataires ) ) {
		error_log( 'EauService — demande de devis de ' . $email . ' NON envoyee : aucune adresse de reception valide.' );
		wp_safe_redirect( add_query_arg( 'es_devis', 'err', $back ) . '#es-devis' );
		exit;
	}

	$ok = false;
	foreach ( $destinataires as $destinataire ) {
		if ( wp_mail( $destinataire, $sujet, $corps, $headers ) ) {
			$ok = true;
		} else {
			error_log( 'EauService — devis non envoye a ' . $destinataire . ' (demande de ' . $email . ').' );
		}
	}

	wp_safe_redirect( add_query_arg( 'es_devis', $ok ? 'ok' : 'err', $back ) . '#es-devis' );
	exit;
}
