  for(var i=1;i<pts.length-1;i++){var xc=((pts[i].x+pts[i+1].x)/2).toFixed(1),yc=((pts[i].y+pts[i+1].y)/2).toFixed(1);d+=' Q'+pts[i].x.toFixed(1)+','+pts[i].y.toFixed(1)+' '+xc+','+yc;}
  d+=' L'+pts[pts.length-1].x.toFixed(1)+','+pts[pts.length-1].y.toFixed(1);
  var r=document.getElementById('es-route'); if(r) r.setAttribute('d',d);
})();
