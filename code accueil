    return {size:'11px',bg:'#6fe0ff',border:'2px solid rgba(8,26,43,.6)',shadow:'0 0 12px #6fe0ff',ls:'11.5px',lw:'600',lc:'#cfe3f3'};
  }
  coast.concat(inland).forEach(function(m,i){
    var d=dot(m[3]);
    var edge=m[4]==='t'?'top:-11px;transform:translate(-50%,-100%);':'top:11px;transform:translate(-50%,0);';
