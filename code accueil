  var coast=[['Toulon',6,60,'town','b'],['Hyères',13,63,'town','t'],['Saint-Tropez',21,65,'town','b'],['Fréjus',29,61,'town','t'],['Saint-Raphaël',36,63,'town','b'],['Mandelieu',44,59,'town','t'],['Cannes',52,56,'hub','b'],['Antibes',62,55,'town','t'],['Cagnes-sur-Mer',69,53,'town','b'],['Nice',77,50,'hub','t'],['Villefranche',84,49,'town','b'],['Monaco',90,46,'hub','t'],['Menton',95,44,'town','b']];
