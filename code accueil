<script>
/* === Scroll reveal (lightweight, uses requestIdleCallback) === */
(function(){
  var obs=new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){e.target.classList.add('on');obs.unobserve(e.target);}
    });
  },{threshold:0.08,rootMargin:'0px 0px -40px 0px'});
  document.querySelectorAll('#esroot .sr').forEach(function(el){obs.observe(el);});
})();

function toggleMenu(){
  var burger=document.getElementById('burger');
  var menu=document.getElementById('mobileMenu');
  var back=document.getElementById('menuBackdrop');
  if(burger) burger.classList.toggle('open');
  if(menu) menu.classList.toggle('open');
  if(back) back.classList.toggle('open');
  document.body.style.overflow=(menu&&menu.classList.contains('open'))?'hidden':'';
}
function closeMenu(){
  var burger=document.getElementById('burger');
  var menu=document.getElementById('mobileMenu');
  var back=document.getElementById('menuBackdrop');
  if(burger) burger.classList.remove('open');
  if(menu) menu.classList.remove('open');
  if(back) back.classList.remove('open');
  document.body.style.overflow='';
}

function setLang(lang){
  document.documentElement.lang=lang;
  var lfr=document.getElementById('lfr'), len=document.getElementById('len');
  if(lfr) lfr.classList.toggle('on',lang==='fr');
  if(len) len.classList.toggle('on',lang==='en');
  document.querySelectorAll('[data-'+lang+']').forEach(function(el){
    /* Ne pas ecraser un parent dont les enfants ont aussi data-fr/data-en */
    if(el.querySelector('[data-fr]')) return;
    var val=el.getAttribute('data-'+lang);
    if(val===null) return;
    /* Placeholders {span}{/span} pour eviter que WordPress encode les balises */
    val=val.replace(/\{span\}/g,'<span>').replace(/\{\/span\}/g,'</span>');
    el.innerHTML=val;
  });
  if(window.esRenderPacks) esRenderPacks();
}

/* ===== TOGGLE NESPRESSO — fonctions globales (meme mecanisme que setLang) ===== */
var esBrand='std';
function esRenderPacks(){
  var lg=document.documentElement.lang==='en'?'en':'fr';
  var TXT={
    brand:{std:{fr:'Covim / Lavazza',en:'Covim / Lavazza'},nes:{fr:'Nespresso',en:'Nespresso'}},
    machine:{std:{fr:'Machine \u00e0 caf\u00e9 Covim / Lavazza',en:'Covim / Lavazza coffee machine'},nes:{fr:'Machine \u00e0 caf\u00e9 Nespresso',en:'Nespresso coffee machine'}}
  };
  document.querySelectorAll('.es-pcard[data-brandable]').forEach(function(c){
    var price=esBrand==='nes'?+c.getAttribute('data-nes'):+c.getAttribute('data-base');
    var newImg=esBrand==='nes'?c.getAttribute('data-img-nes'):c.getAttribute('data-img-std');
    var img=c.querySelector('.es-pcard-img img');
    if(img&&newImg&&img.getAttribute('src')!==newImg){img.style.opacity='0';setTimeout(function(){img.src=newImg;img.style.opacity='1';},180);}
    var amt=c.querySelector('.es-pcard-price .amt');if(amt)amt.textContent=price;
    var bl=c.querySelector('.es-brandlbl');if(bl)bl.textContent=TXT.brand[esBrand][lg];
    var mc=c.querySelector('.es-machine');if(mc)mc.textContent=TXT.machine[esBrand][lg];
  });
  var wrap=document.querySelector('.es-pr-switch-wrap');
  if(wrap){
    var sw=wrap.querySelector('.es-switch');
    var opts=wrap.querySelectorAll('.es-pr-opt');
    if(sw) sw.classList.toggle('on',esBrand==='nes');
    if(opts[0]) opts[0].classList.toggle('on',esBrand==='std');
    if(opts[1]) opts[1].classList.toggle('on',esBrand==='nes');
  }
}
function esSetBrand(b){ if(esBrand!==b){esBrand=b;esRenderPacks();} }
function esToggleBrand(){ esSetBrand(esBrand==='std'?'nes':'std'); }
</script>

