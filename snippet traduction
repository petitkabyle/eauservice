		<span id="es-lang-label"><b>EN</b></span>
	</button>
	<script>
	(function(){
		var DICT = <?php echo wp_json_encode( $dict, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES ); ?>;
		var PH   = <?php echo wp_json_encode( $ph,   JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES ); ?>;
		var btn=document.getElementById('es-lang'),label=document.getElementById('es-lang-label'),KEY='es_lang',lang='fr';
		try{ lang=localStorage.getItem(KEY)||'fr'; }catch(e){}
		function norm(s){ return s.replace(/\u00A0/g,' ').replace(/\s+/g,' '); }
		function translateTextNodes(rootEl){
			if(!rootEl) return;
			var walker=document.createTreeWalker(rootEl,NodeFilter.SHOW_TEXT,{acceptNode:function(node){
				var p=node.parentNode; if(!p) return NodeFilter.FILTER_REJECT;
				var tag=p.nodeName; if(tag==='SCRIPT'||tag==='STYLE'||tag==='NOSCRIPT') return NodeFilter.FILTER_REJECT;
				if(p.closest&&p.closest('#es-lang')) return NodeFilter.FILTER_REJECT;
				if(!node.nodeValue||!node.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
				return NodeFilter.FILTER_ACCEPT; }});
			var nodes=[]; while(walker.nextNode()){ nodes.push(walker.currentNode); }
			nodes.forEach(function(node){
				var raw=node.nodeValue;
				var lead=(raw.match(/^[\s\u00A0]*/)||[''])[0];
				var trail=(raw.match(/[\s\u00A0]*$/)||[''])[0];
				var core=norm(raw.slice(lead.length, raw.length-(trail.length||0)));
				if(DICT.hasOwnProperty(core)){ node.nodeValue=lead+DICT[core]+trail; }
			});
		}
		function translateAttrs(rootEl){
			if(!rootEl) return;
			rootEl.querySelectorAll('[placeholder]').forEach(function(el){ var v=norm(el.getAttribute('placeholder')||''); if(PH.hasOwnProperty(v)){ el.setAttribute('placeholder',PH[v]); } });
			rootEl.querySelectorAll('input[type=submit][value], button[value]').forEach(function(el){ var v=norm(el.value||''); if(DICT.hasOwnProperty(v)){ el.value=DICT[v]; } });
		}
		function applyEN(){ var scope=document.querySelector('main')||document.querySelector('.site-content')||document.querySelector('#content')||document.body; translateTextNodes(scope); translateAttrs(scope); }
		function setLabel(){ label.innerHTML=(lang==='en')?'<b>FR</b>':'<b>EN</b>'; }
		btn.addEventListener('click',function(){
			if(lang==='en'){ lang='fr'; try{ localStorage.setItem(KEY,'fr'); }catch(e){} location.reload(); }
			else { lang='en'; try{ localStorage.setItem(KEY,'en'); }catch(e){} setLabel(); applyEN(); observe(); }
		});
		var obs;
		function observe(){
			if(obs||lang!=='en') return;
			var target=document.querySelector('form.checkout')||document.querySelector('.woocommerce-cart-form')||document.querySelector('.woocommerce')||document.body;
			obs=new MutationObserver(function(){ clearTimeout(observe._t); observe._t=setTimeout(applyEN,120); });
			obs.observe(target,{childList:true,subtree:true});
			if(window.jQuery){ jQuery(document.body).on('updated_checkout updated_cart_totals updated_wc_div wc_fragments_refreshed',function(){ setTimeout(applyEN,60); }); }
		}
		setLabel(); if(lang==='en'){ applyEN(); observe(); }
	})();
	</script>
